{
  "version": "7.2",
  "data_api_version": "3.0",
  "routing_model": {
    "TOOL_BREAKDOWN_FORM": []
  },
  "screens": [
    {
      "id": "TOOL_BREAKDOWN_FORM",
      "title": "Tool Breakdown",
      "terminal": true,
      "data": {
        "machine_no_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "125t_1", "title": "125T-1" }
          ]
        },
        "issue_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "core_pin", "title": "Core Pin" }
          ]
        },
        "employee_phone": {
          "type": "string",
          "__example__": ""
        },
        "employee_department": {
          "type": "string",
          "__example__": ""
        },
        "employee_jmd_route": {
          "type": "string",
          "__example__": ""
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Dropdown",
            "name": "machine_no",
            "label": "Machine No",
            "required": true,
            "data-source": "${data.machine_no_options}"
          },
          {
            "type": "TextInput",
            "name": "tool_name",
            "label": "Die/Fixture/Tool Name",
            "input-type": "text",
            "required": true
          },
          {
            "type": "Dropdown",
            "name": "issue_category",
            "label": "Issue",
            "required": true,
            "data-source": "${data.issue_options}"
          },
          {
            "type": "RadioButtonsGroup",
            "name": "line_stop_threat",
            "label": "Line Stop Threat",
            "required": true,
            "data-source": [
              { "id": "yes", "title": "Yes" },
              { "id": "no", "title": "No" }
            ]
          },
          {
            "type": "PhotoPicker",
            "name": "issue_photo",
            "label": "Photo (required)",
            "photo-source": "camera_gallery",
            "min-uploaded-photos": 1,
            "max-uploaded-photos": 1,
            "max-file-size-kb": 10240
          },
          {
            "type": "Footer",
            "label": "Submit",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "machine_no": "${form.machine_no}",
                "tool_name": "${form.tool_name}",
                "issue_category": "${form.issue_category}",
                "line_stop_threat": "${form.line_stop_threat}",
                "issue_photo": "${form.issue_photo}"
              }
            }
          }
        ]
      }
    }
  ]
}
